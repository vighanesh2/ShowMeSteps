# Supabase project settings (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret used by Supabase Auth (Dashboard → Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# App
APP_NAME=ShowMeSteps
DEBUG=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage bucket names (created via SQL migration or Dashboard)
SCREENSHOTS_BUCKET=screenshots
RECORDINGS_BUCKET=recordings

# Groq (https://console.groq.com/keys) — AI tutorial generation
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Base URL used in review links opened by the extension
PUBLIC_APP_URL=http://localhost:8000

# Production monitoring (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Privacy defaults
PRIVACY_RETAIN_ATTEMPTS_DAYS=365
PRIVACY_ALLOW_AI_COACHING_DEFAULT=true
